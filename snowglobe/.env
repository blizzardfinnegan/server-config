# Docker-compose value fills
# Note that these will _not_ be fed into the 
# containers unless necessary

# Docker internal network information
INTERNAL_SUBNET=
INTERNAL_GATEWAY=

# Container version numbers
AFFINE_IMAGE_TAG=stable
AUDIOBOOKSHELF_VERSION=
GLUETUN_IMAGE_TAG=latest
QBT_IMAGE_TAG=latest
# *arr images are provided by linuxserver
RADARR_IMAGE_TAG=latest
SONARR_IMAGE_TAG=latest
BAZARR_IMAGE_TAG=latest
PROWLARR_IMAGE_TAG=latest
CADDY_IMAGE_TAG=latest
COOKBOOK_VERSION=
MINIFLUX_VERSION=latest
FORGEJO_VERSION=
WOODPECKER_SERVER_IMAGE_TAG=latest
WOODPECKER_AGENT_IMAGE_TAG=latest
IMMICH_VERSION=
IMMICH_BASE_IMAGE_TAG=
JELLYFIN_VERSION=latest
LANDING_PAGE_IMAGE_TAG=latest
PROMETHEUS_EXPORTER_IMAGE_TAG=latest
CONTAINER_ADVISOR_IMAGE_TAG=latest
IT_TOOLS_VERSION=latest

# Affine-specific variables
AFFFINE_DB_USER=
AFFINE_DB_PASS=

# Port allocations
PROMETHEUS_EXPORTER_PORT=
CI_EXTERNAL_PORT=
CADVISOR_PORT=

# Media storage locations
MOVIE_DIR=
TV_DIR=
AUDIOBOOKS_DIR=
PODCASTS_DIR=
EBOOKS_DIR=

# Automation-specific variables
QBT_TEMP_FOLDER=
RADARR_IMPORT_DIR=
SONARR_IMPORT_FOLDER=

# RSS Feed reader DB coordination variables
MINIFLUX_DB_USER=
MINIFLUX_DB_PASS=
MINIFLUX_DB_NAME=

# Immich DB coordination variables
IMMICH_DB_USER=
IMMICH_DB_PASS=
IMMICH_DB_NAME=

# Immich DB build arguments
IMMICH_POSTGRES_MAJOR_VERSION=
IMMICH_VECTORCHORD_TAG=
IMMICH_PGVECTOR_TAG=
IMMICH_PGVECTORS_TAG=
